DIARY_SECRET_KEY=replace-with-at-least-50-random-characters
DIARY_ALLOWED_HOSTS=diary.internal.example,review.example.com
DIARY_CSRF_TRUSTED_ORIGINS=https://review.example.com,https://diary.internal.example
DIARY_TIME_ZONE=America/New_York
DIARY_BEHIND_HTTPS_PROXY=1
DIARY_STATE_ROOT=/var/lib/diary-state
DIARY_CARD_ROOT=/data/cards
DIARY_HOST_CARD_PATH=/mnt/encrypted-nas/diary-cards
# Keep 127.0.0.1 behind a reverse proxy. For a temporary LAN-only test,
# use the container's LAN IP or 0.0.0.0 and enforce a Proxmox firewall rule.
DIARY_BIND_ADDRESS=127.0.0.1
