# Compose release selection. Change JOURNALMAX_RELEASE only after a release is published.
JOURNALMAX_IMAGE=ghcr.io/murmuur22/journal-maxx
JOURNALMAX_RELEASE=0.2.2
JOURNALMAX_BIND_ADDRESS=127.0.0.1
JOURNALMAX_HOST_PORT=8800
JOURNALMAX_UPDATER_RUNTIME_DIR=/run/journalmax-updater
JOURNALMAX_UPDATER_SOCKET=/run/journalmax-updater/updater.sock

# Host-owned persistent paths. Both must exist before Compose starts.
DIARY_HOST_STATE_PATH=/var/lib/journalmax/state
DIARY_HOST_CARD_PATH=/mnt/journalmax-cards

# Application configuration passed into the container.
DIARY_SECRET_KEY=replace-with-at-least-50-random-characters
DIARY_ALLOWED_HOSTS=journalmax.example.internal
DIARY_CSRF_TRUSTED_ORIGINS=https://journalmax.example.internal
DIARY_TIME_ZONE=UTC
DIARY_SESSION_IDLE_TIMEOUT=1800
DIARY_BEHIND_HTTPS_PROXY=1
DIARY_STATE_ROOT=/var/lib/diary-state
DIARY_CARD_ROOT=/data/cards
DIARY_CARD_VOLUME_REQUIRE_MARKER=1
# Fill this after init_card_volume prints the ID, then recreate the container.
DIARY_CARD_VOLUME_ID=
